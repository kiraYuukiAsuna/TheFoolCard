<Project Sdk="Godot.NET.Sdk/4.6.1">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>FoolCard</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Exclude the standalone server project from Godot's build -->
    <Compile Remove="server/**" />
    <None Remove="server/**" />
    <EmbeddedResource Remove="server/**" />
  </ItemGroup>
</Project>
